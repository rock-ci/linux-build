index 8b72ae6449c91..b27d810b19d44 100644
--- a/arch/arm64/boot/dts/rockchip/rk3399-rockpro64.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3399-rockpro64.dtsi
@@ -787,6 +787,7 @@ flash@0 {
 		reg = <0>;
 		spi-max-frequency = <10000000>;
 		vcc-supply = <&vcc_3v0>;
+		m25p,fast-read;
 	};
 };
 
